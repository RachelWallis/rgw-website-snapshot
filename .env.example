# rgw-heating-plumbing — environment template.
#
# Copy to .env.local and fill in. NEVER commit real values, and never copy
# real production values into a local environment.
#
#   cp .env.example .env.local
#
# Anything marked "production only" is deliberately absent from Preview and
# Development scope on Vercel and must not be added back.

# ---------------------------------------------------------------------------
# Email — Resend. PRODUCTION ONLY.
# ---------------------------------------------------------------------------
# Sends contact and quote enquiries to Richard. Leave BLANK locally: with no
# key /api/contact answers 503 and sends nothing, which is the safe local
# state. On 2026-09-09 four test enquiries reached his real inbox from a
# preview deployment that had this key — hence production only.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Sanity CMS — help articles and images
# ---------------------------------------------------------------------------
# Public identifiers, safe to commit in principle; shared with Preview
# deliberately so previews show real content. Read-only from the site.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write token, used only by the publish-help-articles GitHub Action. Stored as
# a repo secret, NOT a Vercel variable. Leave blank locally.
SANITY_API_TOKEN=

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------
# Reviews on the homepage. Shared with Preview: exposure is quota and billing,
# not data (RGW-105).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# GA4. Public by nature — it ships in the page.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# quote-direct — the funnel this site embeds first-party
# ---------------------------------------------------------------------------
# Point at a local quote-direct while developing the funnel.
NEXT_PUBLIC_QUICK_QUOTE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Wolseley supplier pricing (via quote-direct's proxy)
# ---------------------------------------------------------------------------
WOLSELEY_PROXY_URL=
WOLSELEY_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
# Vercel cron authentication. Any long random string locally.
CRON_SECRET=
# Google review link used by the leave-a-review page (RGW-042).
REVIEW_URL=
